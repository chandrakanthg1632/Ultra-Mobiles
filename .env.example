# Copy this file to .env.local and fill in real values.

# Resend API key used to email Contact and Course Registration form
# submissions to ultramobiles07@gmail.com. Without this set, submissions
# are only logged server-side (not delivered) — see src/lib/mailer.ts.
# Get a free key at https://resend.com (Dashboard -> API Keys).
RESEND_API_KEY=re_your_api_key

# Optional: your own verified sending domain in Resend, once set up.
# Leave blank to send from Resend's shared onboarding@resend.dev address.
RESEND_FROM_EMAIL=Ultra Mobiles Website <notifications@yourdomain.com>

# Public site URL, used for the sitemap, robots.txt, and Open Graph tags.
# Set this to your real production domain once you have one.
NEXT_PUBLIC_SITE_URL=https://ultramobiles-fnzh.vercel.app
